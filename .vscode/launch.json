  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pokemon Base (Development)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "args": [
        "--flavor",
        "development",
        "--dart-define-from-file",
        "poke_config.json"
      ],
      "cwd": "${workspaceFolder}/pokemon_base"
    },
    {
      "name": "Pokemon Base (Staging)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "args": [
        "--flavor",
        "staging",
        "--dart-define-from-file",
        "poke_config.json"
      ],
      "cwd": "${workspaceFolder}/pokemon_base"
    },
    {
      "name": "Pokemon Base (Production)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "args": [
        "--flavor",
        "production",
        "--dart-define-from-file",
        "poke_config.json"
      ],
      "cwd": "${workspaceFolder}/pokemon_base"
    }
  ]
}